# Agentic Governance site — local secrets (never commit real values)

# Auth.js / NextAuth v5 (admin twin SSO)
AUTH_SECRET=
# Generate with: npx auth secret

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional comma-separated allowlist override/extension (in addition to hardcoded paul.thorson@gmail.com)
ADMIN_EMAILS=paul.thorson@gmail.com

# Read-only AG feed pull (required when agentic-governance is private)
AG_GITHUB_TOKEN=
# Optional overrides:
# AG_FEED_OWNER=paulthorson
# AG_FEED_REPO=agentic-governance
# AG_FEED_REF=main
# AG_TRACTION_URL=https://raw.githubusercontent.com/paulthorson/agentic-governance/main/data/traction.json
# AG_IMPROVE_URL=https://raw.githubusercontent.com/paulthorson/agentic-governance/main/data/improve.json
